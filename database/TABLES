========== COMMENTS =========
CREATE TABLE comments (
    id INT AUTO_INCREMENT PRIMARY KEY,
    lecturer_username VARCHAR(100) NOT NULL,
    message TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


