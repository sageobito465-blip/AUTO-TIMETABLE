================ USERS ==============
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role ENUM('Admin','Lecturer','Student') NOT NULL,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(100)
);
